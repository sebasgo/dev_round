<Layouts.app flash={@flash} current_user={@current_user}>
  <DevRoundWeb.HostingComponents.header event={@event} tab={:lobby} />
  <DevRoundWeb.HostingComponents.messages messages={@messages} />

  <.form for={@filter_form} id="attendees-filter-form" phx-change="filter_change" class="my-4">
    <div class="flex flex-col sm:flex-row gap-4 items-center">
      <label class="input w-full flex items-center gap-2">
        <.icon name="hero-magnifying-glass" class="w-4 h-4 opacity-70" />
        <input
          type="search"
          name={@filter_form[:filter][:name]}
          id={@filter_form[:filter][:id]}
          value={@filter_form[:filter][:value]}
          placeholder="Filter participants by name..."
          class="grow"
          autocomplete="off"
        />
      </label>
      <div class="join w-full sm:w-auto shrink-0">
        <label
          for={@filter_form[:order][:id]}
          class="join-item bg-neutral border border-base-content/20 border-r-0 px-3 flex items-center text-sm whitespace-nowrap cursor-pointer"
        >
          Sort by
        </label>
        <select
          name={@filter_form[:order][:name]}
          id={@filter_form[:order][:id]}
          class="select join-item w-full sm:w-auto"
        >
          {Phoenix.HTML.Form.options_for_select(@order_options, @filter_form[:order][:value])}
        </select>
      </div>
    </div>
  </.form>

  <div class="relative">
    <div class="bg-base-300 rounded-box my-4 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table id="attendees" class="table table-fixed w-full">
          <thead>
            <tr>
              <th class="w-[50px]">Status</th>
              <th>Participant</th>
              <th class="w-[333px]">Actions</th>
            </tr>
          </thead>
          <tbody>
            <tr
              :for={attendee <- @filtered_attendees}
              :key={attendee.id}
              class={[
                (attendee.checked && "bg-green-900 hover:bg-green-950") || "hover:bg-zinc-950",
                "transition"
              ]}
            >
              <td class="">
                <.icon
                  :if={attendee.checked}
                  name="hero-check-circle"
                  class="w-8 h-8 text-success"
                  aria-label="Checked"
                />
              </td>
              <td>
                <DevRoundWeb.AvatarComponents.user_badge
                  user={attendee.user}
                  remote={attendee.is_remote}
                  experience_level={attendee.experience_level}
                >
                  <p :if={@multiple_langs} class="text-sm">
                    {Enum.map(attendee.langs, fn lang -> lang.name end) |> Enum.intersperse(", ")}
                  </p>
                </DevRoundWeb.AvatarComponents.user_badge>
              </td>
              <td class="flex gap-2">
                <.button
                  class="btn btn btn-success flex gap-2"
                  disabled={attendee.checked}
                  phx-click={JS.push("checkin", value: %{id: attendee.id})}
                >
                  <.icon name="hero-check-circle" class="w-4 h-4" /> Check in
                </.button>
                <.button
                  class="btn btn btn-warning flex gap-2"
                  disabled={!attendee.checked}
                  phx-click={JS.push("checkout", value: %{id: attendee.id})}
                >
                  <.icon name="hero-x-circle" class="w-4 h-4" /> Check out
                </.button>
                <.link
                  patch={
                    ~p"/events/#{@event}/hosting/lobby/registration/edit/#{attendee.user}?#{@query_params}"
                  }
                  phx-click={JS.push_focus()}
                >
                  <.button class="btn btn btn-neutral">
                    <.icon name="hero-pencil" class="w-4 h-4" />
                  </.button>
                </.link>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <.usage_hint>
    Check in participants to include them in the team generation for the pair programming sessions.
  </.usage_hint>

  <.modal
    :if={@live_action == :edit_registration}
    id="event-modal"
    show
    on_cancel={JS.patch(~p"/events/#{@event}/hosting/lobby?#{@query_params}")}
  >
    <.live_component
      module={DevRoundWeb.RegistrationComponent}
      id={@event.id}
      action={@live_action}
      event={@event}
      attendance={@registration_edit_attendee}
      patch={~p"/events/#{@event}/hosting/lobby?#{@query_params}"}
      user={@registration_edit_attendee.user}
      mode={:host}
    />
  </.modal>
</Layouts.app>
