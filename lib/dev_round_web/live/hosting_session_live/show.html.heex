<Layouts.app flash={@flash} current_user={@current_user}>
  <DevRoundWeb.HostingComponents.header event={@event} tab={{:session, @session.id}} />
  <DevRoundWeb.HostingComponents.messages messages={@messages} />

  <div class="grid my-8 gap-4">
    <.toolbar>
      <.button
        class="btn btn-primary"
        disabled={!Enum.empty?(@messages) || @session.teams_locked}
        phx-click={JS.push("build_teams")}
      >
        Build Teams
      </.button>
      <.button
        class="btn btn-success"
        disabled={Enum.empty?(@teams) || @session.live}
        phx-click={JS.push("start_session")}
      >
        Start Session
      </.button>
      <.button
        class="btn btn-warning"
        disabled={Enum.empty?(@teams) || !@session.live}
        phx-click={JS.push("stop_session")}
      >
        Return to Lecture
      </.button>
      <div class="flex-1" />
      <.button
        class="btn btn-error"
        disabled={Enum.empty?(@teams)}
        phx-click={JS.push("reset")}
        data-confirm="Do you really want to reset the session? The session will be stopped and its teams purged."
      >
        Reset Session
      </.button>
    </.toolbar>

    <div class="card grid lg:grid-cols-3 items-center gap-4 bg-base-300">
      <div class="p-2">
        <div class="text-sm text-base-content/70">
          Scheduled Begin
        </div>
        <div class="text-2xl font-mono">
          {@begin}
        </div>
      </div>

      <div class="p-2">
        <div class="text-sm text-base-content/70">
          Scheduled End
        </div>
        <div class="text-2xl font-mono">
          {@end_}
        </div>
      </div>

      <%= if @session.live do %>
        <div class="p-2">
          <div class="text-sm text-base-content/70">
            Time Remaining
          </div>
          <.live_component
            module={DevRoundWeb.EventSessionCountdownLive}
            id={"countdown-#{@session.id}"}
            event_session={@session}
            class="text-2xl font-mono"
            style={nil}
          />
        </div>
      <% end %>
    </div>

    <%= if Enum.empty?(@teams) do %>
      <div class="card flex items-center justify-center w-full aspect-[16/9] bg-base-300">
        <p>
          The teams for this session have not been assigned yet.
        </p>
      </div>
    <% else %>
      <div
        id="hosting-session-teams-grid"
        phx-hook=".TeamMemberDragDrop"
        class="grid gap-4 lg:grid-cols-3"
      >
        <DevRoundWeb.EventComponents.team
          :for={team <- @teams}
          :key={team.id}
          team={team}
          show_member_experience_level={true}
          show_member_langs={true}
          multiple_langs={@multiple_langs}
          show_video_conference_room_url={true}
          allow_adjustments={@allow_adjustments}
        />
      </div>
    <% end %>

    <.usage_hint :if={@allow_adjustments}>
      Before starting the session, team members can be swapped with drag and drop.
    </.usage_hint>
  </div>

  <style>
    .team-member-ghost-hidden {
      opacity: 0 !important;
    }
    .swap-preview-moving {
      z-index: 50;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }
    .swap-placeholder {
      min-height: 42px;
      border-radius: 24px;
      background-color: color-mix(in oklch, var(--color-neutral) 30%, transparent);
      color: var(--color-neutral);
      font-weight: 600;
      box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.06);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-family: var(--font-mono);
      transition: all 0.15s ease;
      user-select: none;
      cursor: pointer;
    }
    .swap-placeholder:hover {
      background-color: color-mix(in oklch, var(--color-neutral) 40%, transparent);
    }
    .team-member-item {
      user-select: none;
      -webkit-user-select: none;
      border-radius: 24px;
      background-color: transparent;
    }
    .team-member-draggable {
      cursor: grab;
    }
    .team-member-draggable:active {
      cursor: grabbing;
    }
    .team-member-dragging {
      opacity: 0.4;
      transform: scale(0.95);
    }
    .swap-valid {
      background-color: color-mix(in oklch, var(--color-success) 20%, transparent);
      cursor: pointer !important;
    }
    .swap-invalid {
      opacity: 0.3;
      filter: grayscale(1);
      cursor: not-allowed !important;
    }
    .swap-target-hover {
      background-color: color-mix(in oklch, var(--color-success) 35%, transparent) !important;
      transform: scale(1.05);
      transition: all 0.15s ease;
    }
  </style>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".TeamMemberDragDrop">
    const getMemberLangs = (el) =>
      el.dataset.memberLangs
        ? el.dataset.memberLangs.split(",").filter(Boolean).map(Number)
        : [];

    export default {
      mounted() {
        this.setupDragDrop();
      },

      updated() {
        this.cleanupDragState();
      },

      destroyed() {
        this.cleanupDragState();
      },

      setupDragDrop() {
        this.hoverTimer = null;
        this.hoverTarget = null;
        this.activeSwap = null; // { partnerEl, placeholder }

        this.handleDragStart = (e) => {
          const sourceEl = e.target.closest("[data-member-id][draggable='true']");
          if (!sourceEl) return;

          this.draggedEl = sourceEl;
          const sourceMemberId = sourceEl.dataset.memberId;
          const sourceTeamId = sourceEl.dataset.teamId;
          const sourceMemberLangs = getMemberLangs(sourceEl);
          const sourceIsRemote = sourceEl.dataset.isRemote === "true";

          e.dataTransfer.effectAllowed = "move";
          e.dataTransfer.setData("text/plain", sourceMemberId);

          // Create a fully rounded drag preview with transparent corners
          const badge = sourceEl.querySelector(".rounded-full") || sourceEl.firstElementChild || sourceEl;
          const dragGhost = badge.cloneNode(true);
          dragGhost.style.position = "fixed";
          dragGhost.style.top = "-9999px";
          dragGhost.style.left = "-9999px";
          dragGhost.style.width = `${sourceEl.offsetWidth}px`;
          dragGhost.style.height = `${sourceEl.offsetHeight}px`;
          dragGhost.style.borderRadius = "24px";
          dragGhost.style.overflow = "hidden";
          dragGhost.style.backgroundColor = "var(--color-neutral-content)";
          dragGhost.style.margin = "0";
          dragGhost.style.boxSizing = "border-box";
          dragGhost.style.pointerEvents = "none";
          dragGhost.style.zIndex = "99999";

          document.body.appendChild(dragGhost);

          const rect = sourceEl.getBoundingClientRect();
          const offsetX = e.clientX - rect.left;
          const offsetY = e.clientY - rect.top;

          e.dataTransfer.setDragImage(dragGhost, offsetX, offsetY);

          setTimeout(() => {
            dragGhost.remove();
          }, 0);

          // Instantly hide the dragged member from its team once drag ghost image is captured
          setTimeout(() => {
            if (this.draggedEl) {
              this.draggedEl.classList.add("team-member-ghost-hidden");
            }
          }, 0);

          const allMembers = Array.from(this.el.querySelectorAll("[data-member-id]"));
          allMembers.forEach((targetEl) => {
            const targetMemberId = targetEl.dataset.memberId;
            const targetTeamId = targetEl.dataset.teamId;
            const targetMemberLangs = getMemberLangs(targetEl);
            const targetIsRemote = targetEl.dataset.isRemote === "true";

            if (targetMemberId === sourceMemberId) {
              return;
            }

            const isDifferentTeam = targetTeamId !== sourceTeamId;
            const sameRemote = targetIsRemote === sourceIsRemote;

            if (!isDifferentTeam || !sameRemote) {
              targetEl.classList.add("swap-invalid");
              targetEl.dataset.dropAllowed = "false";
              return;
            }

            // Check Source Team compatibility when targetMember is added
            const otherSourceMembers = allMembers.filter(
              (m) => m.dataset.teamId === sourceTeamId && m.dataset.memberId !== sourceMemberId
            );
            let sourceTeamCommonLangs = targetMemberLangs;
            for (const otherEl of otherSourceMembers) {
              const otherLangs = getMemberLangs(otherEl);
              sourceTeamCommonLangs = sourceTeamCommonLangs.filter((id) => otherLangs.includes(id));
            }
            const sourceTeamValid = sourceTeamCommonLangs.length > 0;

            // Check Target Team compatibility when sourceMember is added
            const otherTargetMembers = allMembers.filter(
              (m) => m.dataset.teamId === targetTeamId && m.dataset.memberId !== targetMemberId
            );
            let targetTeamCommonLangs = sourceMemberLangs;
            for (const otherEl of otherTargetMembers) {
              const otherLangs = getMemberLangs(otherEl);
              targetTeamCommonLangs = targetTeamCommonLangs.filter((id) => otherLangs.includes(id));
            }
            const targetTeamValid = targetTeamCommonLangs.length > 0;

            const isValid = sourceTeamValid && targetTeamValid;

            if (isValid) {
              targetEl.classList.add("swap-valid");
              targetEl.dataset.dropAllowed = "true";
            } else {
              targetEl.classList.add("swap-invalid");
              targetEl.dataset.dropAllowed = "false";
            }
          });
        };

        this.handleDragOver = (e) => {
          const dropTarget = e.target.closest("[data-drop-allowed='true'], .swap-placeholder");
          if (dropTarget) {
            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
          } else {
            e.dataTransfer.dropEffect = "none";
          }
        };

        this.handleDragEnter = (e) => {
          const targetEl = e.target.closest("[data-member-id][data-drop-allowed='true'], .swap-placeholder");
          if (!targetEl || !this.draggedEl) return;

          e.preventDefault();

          if (this.activeSwap) {
            if (targetEl === this.activeSwap.partnerEl || targetEl === this.activeSwap.placeholder) {
              return;
            }
          }

          if (this.hoverTarget !== targetEl) {
            if (this.hoverTimer) {
              clearTimeout(this.hoverTimer);
              this.hoverTimer = null;
            }

            if (this.activeSwap) {
              this.revertSwapPreview(true);
            }

            this.hoverTarget = targetEl;

            this.hoverTimer = setTimeout(() => {
              if (this.draggedEl && this.hoverTarget === targetEl) {
                const partnerEl = targetEl.classList.contains("swap-placeholder")
                  ? this.el.querySelector(`[data-member-id='${targetEl.dataset.memberId}']`)
                  : targetEl;

                if (partnerEl) {
                  this.animateSwapPreview(partnerEl);
                }
              }
            }, 150);
          }
        };

        this.handleDragLeave = (e) => {
          const related = e.relatedTarget;

          if (!related || !this.el.contains(related)) {
            if (this.hoverTimer) {
              clearTimeout(this.hoverTimer);
              this.hoverTimer = null;
            }
            if (this.activeSwap) {
              this.revertSwapPreview(true);
            }
            this.hoverTarget = null;
            return;
          }

          const validParent = related.closest("[data-drop-allowed='true'], .swap-placeholder");
          if (!validParent) {
            if (this.hoverTimer) {
              clearTimeout(this.hoverTimer);
              this.hoverTimer = null;
            }
            if (this.activeSwap) {
              this.revertSwapPreview(true);
            }
            this.hoverTarget = null;
          }
        };

        this.handleDrop = (e) => {
          e.preventDefault();
          const dropTarget = e.target.closest("[data-drop-allowed='true'], .swap-placeholder");
          if (dropTarget && this.draggedEl) {
            const sourceMemberId = this.draggedEl.dataset.memberId;
            const targetMemberId = dropTarget.dataset.memberId;

            if (sourceMemberId && targetMemberId && sourceMemberId !== targetMemberId) {
              this.pushEvent("swap_team_members", {
                source_member_id: sourceMemberId,
                target_member_id: targetMemberId,
              });
            }
          }
          this.cleanupDragState();
        };

        this.handleDragEnd = (_e) => {
          this.cleanupDragState();
        };

        this.el.addEventListener("dragstart", this.handleDragStart);
        this.el.addEventListener("dragover", this.handleDragOver);
        this.el.addEventListener("dragenter", this.handleDragEnter);
        this.el.addEventListener("dragleave", this.handleDragLeave);
        this.el.addEventListener("drop", this.handleDrop);
        this.el.addEventListener("dragend", this.handleDragEnd);
      },

      animateSwapPreview(partnerEl) {
        if (!this.draggedEl || !partnerEl) return;
        if (this.activeSwap && this.activeSwap.partnerEl === partnerEl) return;

        if (this.activeSwap) {
          this.revertSwapPreview(false);
        }

        const sourceEl = this.draggedEl;
        const firstRect = partnerEl.getBoundingClientRect();

        const targetPlaceholder = document.createElement("div");
        targetPlaceholder.className = "swap-placeholder";
        targetPlaceholder.dataset.memberId = partnerEl.dataset.memberId;
        targetPlaceholder.dataset.dropAllowed = "true";
        targetPlaceholder.dataset.teamId = partnerEl.dataset.teamId;
        targetPlaceholder.style.height = `${partnerEl.offsetHeight || 42}px`;
        targetPlaceholder.innerHTML = '<span class="flex items-center gap-1.5 font-semibold"><svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>Drop to swap</span>';

        partnerEl.parentNode.insertBefore(targetPlaceholder, partnerEl);

        sourceEl.style.display = "none";
        sourceEl.parentNode.insertBefore(partnerEl, sourceEl);

        const lastRect = partnerEl.getBoundingClientRect();
        const deltaX = firstRect.left - lastRect.left;
        const deltaY = firstRect.top - lastRect.top;

        partnerEl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
        partnerEl.style.transition = "none";
        partnerEl.classList.add("swap-preview-moving");

        partnerEl.offsetHeight;

        requestAnimationFrame(() => {
          partnerEl.style.transition = "transform 250ms cubic-bezier(0.2, 0, 0, 1)";
          partnerEl.style.transform = "translate(0, 0)";
        });

        this.activeSwap = { partnerEl, placeholder: targetPlaceholder };
      },

      revertSwapPreview(animated = true) {
        if (!this.activeSwap) return;

        const { partnerEl, placeholder } = this.activeSwap;
        this.activeSwap = null;
        const sourceEl = this.draggedEl;

        if (animated && partnerEl.isConnected && placeholder && placeholder.isConnected) {
          const firstRect = partnerEl.getBoundingClientRect();

          placeholder.parentNode.insertBefore(partnerEl, placeholder);
          placeholder.remove();

          if (sourceEl) {
            sourceEl.style.display = "";
          }

          const lastRect = partnerEl.getBoundingClientRect();
          const deltaX = firstRect.left - lastRect.left;
          const deltaY = firstRect.top - lastRect.top;

          partnerEl.style.transform = `translate(${deltaX}px, ${deltaY}px)`;
          partnerEl.style.transition = "none";
          partnerEl.offsetHeight;

          requestAnimationFrame(() => {
            partnerEl.style.transition = "transform 250ms cubic-bezier(0.2, 0, 0, 1)";
            partnerEl.style.transform = "translate(0, 0)";
          });

          const onEnd = () => {
            partnerEl.removeEventListener("transitionend", onEnd);
            partnerEl.style.transform = "";
            partnerEl.style.transition = "";
            partnerEl.classList.remove("swap-preview-moving");
          };

          partnerEl.addEventListener("transitionend", onEnd, { once: true });
          setTimeout(onEnd, 260);
        } else {
          if (placeholder && placeholder.isConnected) {
            placeholder.parentNode.insertBefore(partnerEl, placeholder);
            placeholder.remove();
          }
          if (sourceEl) {
            sourceEl.style.display = "";
          }
          partnerEl.style.transform = "";
          partnerEl.style.transition = "";
          partnerEl.classList.remove("swap-preview-moving");
        }
      },

      cleanupDragState() {
        if (this.hoverTimer) {
          clearTimeout(this.hoverTimer);
          this.hoverTimer = null;
        }

        this.revertSwapPreview(false);

        if (this.draggedEl) {
          this.draggedEl.classList.remove("team-member-ghost-hidden");
          this.draggedEl.style.display = "";
          this.draggedEl.style.opacity = "";
          this.draggedEl = null;
        }

        this.hoverTarget = null;
        this.activeSwap = null;

        const allMembers = this.el.querySelectorAll("[data-member-id]");
        allMembers.forEach((el) => {
          el.classList.remove(
            "team-member-dragging",
            "swap-valid",
            "swap-invalid",
            "swap-target-hover",
            "team-member-ghost-hidden",
            "swap-preview-moving"
          );
          el.style.transform = "";
          el.style.transition = "";
          delete el.dataset.dropAllowed;
        });

        const placeholders = this.el.querySelectorAll(".swap-placeholder");
        placeholders.forEach((el) => el.remove());
      },
    };
  </script>
</Layouts.app>
